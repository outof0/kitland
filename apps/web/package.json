{
  "name": "@kitland/web",
  "version": "0.1.1",
  "private": true,
  "description": "Kitland public landing page",
  "license": "MIT",
  "author": "OutOf0 <hello.outof0@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_DEV_BACKGROUND=0 astro dev",
    "dev:stop": "astro dev stop",
    "build": "node ./scripts/clean-dist.mjs && astro check && astro build",
    "bundle:check": "node ./scripts/verify-bundle-budget.mjs",
    "seo:check": "node ./scripts/verify-static-seo.mjs",
    "rollout:artifact:check": "node ./scripts/verify-rollout-artifact.mjs",
    "preview": "astro preview",
    "test": "vitest run --configLoader runner",
    "test:e2e": "playwright test",
    "test:e2e:rollout": "playwright test e2e/web-rollout.smoke.spec.ts",
    "typecheck": "astro check",
    "lint": "oxlint src scripts e2e playwright.config.ts --react-plugin --jsx-a11y-plugin --deny-warnings"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@kitland/core": "workspace:*",
    "@kitland/tools": "workspace:*",
    "@kitland/ui": "workspace:^",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/react": "6.0.4",
    "@astrojs/sitemap": "3.7.3",
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "astro": "7.2.9",
    "satori": "^0.33.4",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
