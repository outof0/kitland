---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { LandingPage } from "@/components/landing/LandingPage";

const description =
  "Open local-first developer tools on kitland.dev. Install MCP from npm, VS Code from the Marketplace or Open VSX, and the extension from Chrome or Firefox.";
---

<BaseLayout
  title="Kitland — Developer tools that keep data local"
  description={description}
  canonicalPath="/"
  socialImageAlt="Kitland local-first Base64 workspace preview"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Kitland",
    url: "https://kitland.dev/",
    description,
  }}
>
  <LandingPage />
  <script src="../scripts/scroll-reveal.ts"></script>
</BaseLayout>
