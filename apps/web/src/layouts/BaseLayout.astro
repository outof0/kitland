---
import "@/styles/global.css";
import "@/components/ui/codemirror.css";
import { ClientRouter } from "astro:transitions";

type JsonLd = Record<string, unknown>;

type Props = {
  title: string;
  description: string;
  canonicalPath?: string;
  robots?: string;
  socialImageAlt?: string;
  socialImagePath?: string;
  structuredData?: JsonLd | readonly JsonLd[];
};

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  robots = "index,follow",
  socialImageAlt = "Kitland local-first developer tool workbench",
  socialImagePath,
  structuredData,
} = Astro.props;
const site = Astro.site ?? new URL("https://kitland.dev");
const canonicalUrl = new URL(canonicalPath, site).toString();
const resolvedSocialImagePath =
  socialImagePath ??
  (canonicalPath === "/"
    ? "/og/index.png"
    : canonicalPath === "/explore" || canonicalPath === "/explore/"
      ? "/og/explore.png"
      : canonicalPath.startsWith("/explore/")
        ? `/og/${canonicalPath.replace(/^\/explore\/?/, "").replace(/\/$/, "")}.png`
        : "/og-kitland-workbench.png");
const socialImageUrl = new URL(resolvedSocialImagePath, site).toString();
const schemas = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];

// `set:html` is intentional for JSON-LD. Escape `<` so a user-controlled
// registry field can never terminate this script tag.
const serializedSchemas = JSON.stringify(schemas).replaceAll("<", "\\u003c");

// Keep event-handler and style attributes unavailable everywhere. Astro still
// adds page-specific hashes for its own processed inline bootstrap/styles.
Astro.csp?.insertScriptResource({ resource: "'none'", kind: "attribute" });
Astro.csp?.insertStyleResource({ resource: "'none'", kind: "attribute" });
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0b0c10" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />

    <meta property="og:site_name" content="Kitland" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var raw = localStorage.getItem("kitland.theme");
          if (!raw) return;
          var parsed = JSON.parse(raw);
          var value =
            parsed && typeof parsed === "object" && "value" in parsed ? parsed.value : parsed;
          if (value === "light" || value === "dark") {
            document.documentElement.dataset.theme = value;
          }
        } catch (error) {
          /* Storage can be unavailable; keep the static data-theme. */
        }
      })();
    </script>
    <ClientRouter fallback="none" />
    <script>
      document.addEventListener("astro:before-swap", (event) => {
        const theme = document.documentElement.dataset.theme;
        if (theme) event.newDocument.documentElement.dataset.theme = theme;
      });
    </script>

    {
      schemas.length > 0 ? (
        <script is:inline type="application/ld+json" set:html={serializedSchemas} />
      ) : null
    }
  </head>
  <body>
    <slot />
  </body>
</html>
