---
import type { ToolDefinition } from "@kitland/tools";
import type { ToolSeoContent } from "@/data/toolSeo";
import "@/styles/seo.css";

type Props = {
  tool: ToolDefinition;
  content: ToolSeoContent;
};

const { tool, content } = Astro.props;
const headingId = `${tool.slug}-guide-heading`;
---

<section class="tool-seo-guide" aria-labelledby={headingId}>
  <div class="tool-seo-guide__intro">
    <p class="tool-seo-guide__eyebrow">About this tool</p>
    <h2 id={headingId}>{content.heading}</h2>
    <p>{content.introduction}</p>
  </div>

  <div class="tool-seo-guide__grid">
    <section aria-labelledby={`${tool.slug}-steps`}>
      <h3 id={`${tool.slug}-steps`}>How to use it</h3>
      <ol>
        {content.steps.map((step) => <li>{step}</li>)}
      </ol>
    </section>
    <section aria-labelledby={`${tool.slug}-uses`}>
      <h3 id={`${tool.slug}-uses`}>Useful for</h3>
      <ul>
        {content.useCases.map((useCase) => <li>{useCase}</li>)}
      </ul>
    </section>
  </div>

  <section class="tool-seo-guide__faq" aria-labelledby={`${tool.slug}-faq`}>
    <h3 id={`${tool.slug}-faq`}>Frequently asked questions</h3>
    {content.faqs.map((faq) => (
      <details>
        <summary>
          <span>{faq.question}</span>
          <svg class="faq-chevron" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <p>{faq.answer}</p>
      </details>
    ))}
  </section>
</section>
