# Keep the Cloudflare Pages production and preview hostnames out of search.
# The canonical public origin is https://kitland.dev (see sitemap generation).
https://kitland.pages.dev/*
  X-Robots-Tag: noindex

https://:deployment.kitland.pages.dev/*
  X-Robots-Tag: noindex

# These rules apply to every static Pages response. Per-page CSP is emitted by
# Astro because its script/style hashes are intentionally specific to each file.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()

# Astro emits content-addressed JS and CSS in this directory, so browser caches
# can safely retain them until the next filename changes.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
