{
  "name": "@kitland/browser-extension",
  "version": "0.1.1",
  "private": true,
  "description": "Permission-free browser shell for the Kitland developer tool suite",
  "license": "MIT",
  "author": "OutOf0 <hello.outof0@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "preview": "vite preview --host 127.0.0.1 --port 43817 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "oxlint src tests e2e scripts vite.config.ts vitest.config.ts playwright.config.ts --vitest-plugin --deny-warnings",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "package:check": "node ./scripts/verify-package.mjs",
    "package": "pnpm build && node ./scripts/create-zip.mjs && node ./scripts/verify-package.mjs --archive",
    "package:chrome": "pnpm build && node ./scripts/create-zip.mjs && node ./scripts/verify-package.mjs --archive",
    "package:firefox": "pnpm build && node ./scripts/create-browser-artifacts.mjs && node ./scripts/verify-package.mjs --archive",
    "package:all": "pnpm build && node ./scripts/create-browser-artifacts.mjs && node ./scripts/verify-package.mjs --archive",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm package:check && pnpm test:smoke"
  },
  "dependencies": {
    "@kitland/core": "workspace:*",
    "@kitland/tools": "workspace:*",
    "@kitland/ui": "workspace:^",
    "bcryptjs": "^3.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
