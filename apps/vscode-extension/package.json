{
  "name": "kitland-tools",
  "displayName": "Kitland Tools",
  "version": "0.1.1",
  "private": true,
  "description": "Privacy-first developer tools that run locally in Visual Studio Code.",
  "categories": [
    "Other"
  ],
  "keywords": [
    "converter",
    "developer tools",
    "formatter",
    "generator",
    "local-first",
    "privacy"
  ],
  "homepage": "https://kitland.dev",
  "bugs": {
    "url": "https://github.com/OutOf0/kitland/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OutOf0/kitland.git",
    "directory": "apps/vscode-extension"
  },
  "publisher": "outof0",
  "main": "./dist/desktop/extension.cjs",
  "browser": "./dist/web/extension.js",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "oxlint src test scripts --vitest-plugin --deny-warnings",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "pnpm build && vscode-test",
    "package:smoke": "pnpm build && node ./scripts/package-smoke.mjs && vsce ls --no-dependencies",
    "package:vsix": "pnpm package:smoke && node ./scripts/prepare-artifacts.mjs && vsce package --no-dependencies --out ./artifacts/kitland-tools.vsix",
    "package:vsix:versioned": "pnpm package:smoke && node ./scripts/prepare-artifacts.mjs && vsce package --no-dependencies --out ./artifacts/kitland-tools-v$(node -p \"require('./package.json').version\").vsix",
    "vscode:prepublish": "pnpm build && node ./scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@kitland/core": "workspace:*",
    "@kitland/tools": "workspace:*",
    "@kitland/ui": "workspace:^",
    "@lezer/highlight": "^1.2.3",
    "@uiw/react-codemirror": "^4.25.11",
    "bcryptjs": "^3.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/vscode": "1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "oxlint": "^1.77.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "contributes": {
    "commands": [
      {
        "command": "kitland.base64.encodeSelection",
        "title": "Base64: Encode and Replace Selection",
        "category": "Kitland",
        "enablement": "editorHasSelection"
      },
      {
        "command": "kitland.base64.decodeSelection",
        "title": "Base64: Decode and Replace Selection",
        "category": "Kitland",
        "enablement": "editorHasSelection"
      },
      {
        "command": "kitland.curlConverter.convertSelection",
        "title": "cURL Converter: Convert Selection to Fetch",
        "category": "Kitland",
        "enablement": "editorHasSelection"
      },
      {
        "command": "kitland.openTool",
        "title": "Open Tool...",
        "category": "Kitland",
        "icon": "$(tools)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kitland",
          "title": "Kitland",
          "icon": "assets/kitland-activitybar.svg"
        }
      ]
    },
    "views": {
      "kitland": [
        {
          "type": "webview",
          "id": "kitland.mainView",
          "name": "Kitland Tools"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "kitland.openTool",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "kitland.openTool",
          "when": "view == kitland.mainView",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "kitland.base64.encodeSelection",
          "when": "editorHasSelection",
          "group": "1_modification@90"
        },
        {
          "command": "kitland.base64.decodeSelection",
          "when": "editorHasSelection",
          "group": "1_modification@91"
        },
        {
          "command": "kitland.curlConverter.convertSelection",
          "when": "editorHasSelection",
          "group": "1_modification@92"
        }
      ]
    }
  },
  "activationEvents": [
    "onCommand:kitland.base64.decodeSelection",
    "onCommand:kitland.base64.encodeSelection",
    "onCommand:kitland.curlConverter.convertSelection",
    "onCommand:kitland.openTool",
    "onView:kitland.mainView"
  ],
  "icon": "assets/icon-128.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Registered local tools only process text you explicitly select or enter; they do not execute workspace code or access workspace files."
    },
    "virtualWorkspaces": {
      "supported": true
    }
  }
}
