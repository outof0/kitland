{
  "name": "@kitland/tools",
  "version": "0.1.1",
  "private": true,
  "description": "Tool definitions, schemas, and registry metadata for Kitland",
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "release:verify": "vitest run --config vitest.release.config.ts",
    "release:verify:rollout": "vitest run --config vitest.surface-rollout.config.ts",
    "lint": "oxlint src --vitest-plugin --deny-warnings"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
