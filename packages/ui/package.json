{
  "name": "@kitland/ui",
  "version": "0.1.1",
  "private": true,
  "description": "Host-agnostic Kitland tool shells — same UI, host only supplies runtime wrap",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./tokens.css",
    "./sources.css": "./sources.css",
    "./theme.css": "./theme.css",
    "./workspace.css": "./workspace.css",
    "./code-editor.css": "./code-editor.css",
    "./registry": "./src/tools/shared-registry-tools.tsx",
    "./code-editor": "./src/components/CodeEditor.tsx",
    "./base64-protocol": "./src/lib/base64-worker-protocol.ts",
    "./tools/*": "./src/tools/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "lint": "oxlint src --vitest-plugin --deny-warnings"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@kitland/core": "workspace:*",
    "@kitland/tools": "workspace:*",
    "@lezer/highlight": "^1.2.3",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.33.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^20.11.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
